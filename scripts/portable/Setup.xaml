<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BREKTRA Setup" Width="1020" Height="780" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen"
 Background="#0b1112" Foreground="#edf6f4" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1a2a2c"/><Setter Property="Foreground" Value="#edf6f4"/><Setter Property="BorderBrush" Value="#2a3d40"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77e2c3"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#b4c9f3"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#10191b"/><Setter Property="Foreground" Value="#edf6f4"/><Setter Property="CaretBrush" Value="#77e2c3"/><Setter Property="BorderBrush" Value="#2a3d40"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#10191b"/><Setter Property="Foreground" Value="#edf6f4"/><Setter Property="BorderBrush" Value="#2a3d40"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,12,0,8"/><Setter Property="Foreground" Value="#edf6f4"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#77e2c3"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/><Setter Property="Foreground" Value="#a4b9b6"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#131f21"/><Setter Property="BorderBrush" Value="#2a3d40"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,8,0,16"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#10191b" BorderBrush="#2a3d40" BorderThickness="0,0,1,0" Padding="28,32">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Background="#77e2c3" CornerRadius="10" Width="38" Height="38"><TextBlock Text="B" Foreground="#0a2820" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="BREKTRA" FontSize="21" FontWeight="Bold" Margin="10,7,0,0"/></StackPanel>
     <TextBlock Text="YOUR WORKSPACE, READY." Style="{StaticResource Eyebrow}" Margin="0,8,0,38"/>
     <StackPanel x:Name="Steps"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border Background="#193b33" CornerRadius="10" Padding="14" Margin="0,20,0,14"><TextBlock Text="Local by design.&#10;Your credentials stay on this PC." Foreground="#8ae0b6" FontSize="12"/></Border>
     <TextBlock x:Name="Version" Foreground="#a4b9b6" FontSize="11"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="36,32,36,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18"><TextBlock x:Name="StepLabel" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold" LineHeight="38"/><TextBlock x:Name="Subtitle" Foreground="#a4b9b6" Margin="0,10,0,0"/></StackPanel>
   <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <Grid x:Name="Pages">
     <StackPanel x:Name="Welcome">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="A smooth start. A focused workspace." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
       <TextBlock Text="01   Check your PC and the included app runtime" Margin="0,6"/>
       <TextBlock Text="02   Install Ollama and download your local AI model" Margin="0,6"/>
       <TextBlock Text="03   Create or sign in to your BREKTRA account" Margin="0,6"/>
       <TextBlock Text="04   Connect your Google Sheets workspace" Margin="0,6"/>
       <TextBlock Text="05   Review readiness and open BREKTRA" Margin="0,6"/>
      </StackPanel></Border>
      <TextBlock Text="Next guides you through each step. Setup downloads software only when needed. Google permissions and account approvals remain yours to complete." Style="{StaticResource Muted}"/>
      <TextBlock Text="Allow several GB of downloads and keep your PC online. This folder is your portable installation; keep its files together. You can rerun setup to check or repair it." Style="{StaticResource Muted}"/>
     </StackPanel>
     <StackPanel x:Name="Checks" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Everything in its place" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="We check Windows compatibility, write access, free space, the bundled Node runtime and essential BREKTRA files."/><TextBlock Text="Node is already included. No terminal commands or separate Node installation are needed." Foreground="#77e2c3" Margin="0,18,0,0"/></StackPanel></Border>
      <TextBlock Text="Keep this folder in a normal writable location. Extract the complete ZIP before running setup." Style="{StaticResource Muted}"/>
     </StackPanel>
     <StackPanel x:Name="AI" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="AI that runs on your PC" FontSize="21" Margin="0,0,0,8"/>
       <RadioButton x:Name="StandardModel" IsChecked="True" GroupName="Model" Content="Qwen 3 · 4B    /    Standard"/>
       <TextBlock Text="More capable drafts. Choose this for a PC with more memory." Foreground="#a4b9b6" Margin="20,0,0,8"/>
       <RadioButton x:Name="SmallModel" GroupName="Model" Content="Qwen 3 · 1.7B    /    Smaller download"/>
       <TextBlock Text="A lighter starting point for PCs with less memory." Foreground="#a4b9b6" Margin="20,0,0,8"/>
      </StackPanel></Border>
      <TextBlock Text="Next installs Ollama for your Windows user if it is missing, verifies its publisher, starts the local service and downloads your model. Existing installations and complete models are reused." Style="{StaticResource Muted}"/>
      <WrapPanel><Button x:Name="OllamaLink" Content="Official Ollama download ↗"/><Button x:Name="CancelDownload" Content="Cancel download" Visibility="Collapsed"/></WrapPanel>
      <TextBlock Text="Use the official download page if automatic installation is blocked. Ollama is separate software and can keep running after BREKTRA closes." Foreground="#a4b9b6" FontSize="12"/>
     </StackPanel>
     <StackPanel x:Name="Account" Visibility="Collapsed">
      <TextBlock x:Name="AccountHint" Style="{StaticResource Muted}"/>
      <StackPanel x:Name="NewAccount"><TextBlock Text="Your name"/><TextBox x:Name="OwnerName" MaxLength="120"/><TextBlock Text="Username"/><TextBox x:Name="OwnerUsername" MaxLength="32"/></StackPanel>
      <TextBlock x:Name="EmailLabel" Text="Email"/><TextBox x:Name="OwnerEmail" MaxLength="320"/>
      <TextBlock Text="Password"/><PasswordBox x:Name="OwnerPassword" MaxLength="200"/>
      <TextBlock Text="Use at least 12 characters for a new account. The first account is this installation's owner. Your browser will ask you to sign in again when BREKTRA opens." Foreground="#a4b9b6" FontSize="12"/>
     </StackPanel>
     <StackPanel x:Name="Google" Visibility="Collapsed">
      <TextBlock x:Name="GoogleHint" Text="Google requires you to grant access. Complete these steps in your browser, then choose your key and spreadsheet below." Style="{StaticResource Muted}"/>
      <WrapPanel><Button x:Name="SheetsApiLink" Content="1. Enable Sheets API ↗"/><Button x:Name="ServiceAccountLink" Content="2. Create service account ↗"/><Button x:Name="NewSheetLink" Content="3. Create spreadsheet ↗"/></WrapPanel>
      <TextBlock Text="In Google Cloud: choose your project, enable Sheets API, create a service account, then use Keys → Add key → Create new key → JSON. No project-wide role or domain-wide delegation is needed for a shared sheet." Foreground="#a4b9b6" FontSize="12" Margin="0,0,0,14"/>
      <StackPanel x:Name="SheetFields">
       <TextBlock Text="Service-account JSON key"/><DockPanel><Button x:Name="ChooseKey" Content="Choose file" DockPanel.Dock="Right" Margin="10,5,0,14"/><TextBox x:Name="KeyPath" IsReadOnly="True"/></DockPanel>
       <DockPanel Margin="0,0,0,12"><Button x:Name="CopyEmail" Content="Copy email" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock x:Name="ServiceEmail" Text="Choose a key to display the service-account email." Foreground="#77e2c3" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="Share a dedicated control spreadsheet with that email as Editor. Paste its URL here:"/><TextBox x:Name="SheetUrl" MaxLength="2000"/>
       <TextBlock Text="Next checks access without changing the sheet. You'll confirm before control tabs are created. Keep your original CRM separate." Foreground="#a4b9b6" FontSize="12"/>
      </StackPanel>
      <Button x:Name="SkipGoogle" Content="Set up Sheets later · use demo data" HorizontalAlignment="Left" Margin="0,20,0,10"/>
     </StackPanel>
     <StackPanel x:Name="Review" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your setup at a glance" FontSize="21" Margin="0,0,0,18"/><TextBlock x:Name="ReviewText" LineHeight="30"/></StackPanel></Border>
      <TextBlock Text="LinkedIn and Gmail authorization require your own accounts and provider approval. Continue in Settings when needed. Connecting an identity does not enable LinkedIn outreach." Style="{StaticResource Muted}"/>
      <TextBlock Text="BREKTRA opens in your browser. Use STOP BREKTRA in this folder to stop it completely. Keep this folder's .runtime private and preserve it when upgrading." Foreground="#a4b9b6" FontSize="12"/>
     </StackPanel>
     <StackPanel x:Name="Complete" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="You're ready to begin." FontSize="26" Foreground="#77e2c3" Margin="0,0,0,18"/><TextBlock Text="BREKTRA is open in your default browser. Sign in and make this workspace yours."/><TextBlock Text="You can open Setup_BREKTRA.exe again at any time. It always checks the installation in this folder." Foreground="#a4b9b6" Margin="0,18,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border x:Name="StatusCard" Grid.Row="2" Background="#162426" BorderBrush="#2a3d40" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,18" Visibility="Collapsed">
    <StackPanel><TextBlock x:Name="StatusText" FontSize="13"/><ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" Foreground="#77e2c3" Background="#2a3d40" BorderThickness="0" Visibility="Collapsed"/></StackPanel>
   </Border>
   <DockPanel Grid.Row="3"><TextBlock x:Name="Footer" Text="OBSIDIAN MINT  /  GUIDED SETUP" Foreground="#a4b9b6" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Back" Content="Back" Margin="0,0,12,0"/><Button x:Name="Next" Content="Let's begin  →" Background="#77e2c3" Foreground="#0a2820" BorderBrush="#77e2c3" FontWeight="SemiBold" MinWidth="130" Margin="0" IsDefault="True"/></StackPanel></DockPanel>
  </Grid>
 </Grid>
</Window>
