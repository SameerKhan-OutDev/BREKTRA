# Local users: use Settings > Real workspace setup instead of editing this file.
# Saved local setup choices take precedence; set BREKTRA_USE_ENV=1 to use only
# environment configuration (and disable local setup changes).
# Demo data stays in memory. No email or LinkedIn actions are sent in demo.
PORT=4310
# Portable launcher enables trusted LAN sharing by default. Set 0 for PC-only.
# LAN browsers must sign in; new registrations require administrator approval.
BREKTRA_LAN=1
STORAGE_MODE=demo
# To persist to Sheets: set STORAGE_MODE=sheets, share the control spreadsheet
# with the service account email, and enable the Google Sheets API.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json
CONTROL_SPREADSHEET_ID=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Authenticated HTTPS team hosting: docs/HOSTED_SETUP.md
# Copy deploy/hosted.env.example outside the release folder for server deployment.

# Sign-in is required by default and cannot be disabled for LAN access.
# BREKTRA_AUTH=0 is an explicit loopback-only development bypass.
