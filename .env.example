# Demo data stays in memory. No actions are sent to LinkedIn.
PORT=4310
STORAGE_MODE=demo
# To persist to Sheets: set STORAGE_MODE=sheets, share the control spreadsheet
# with the service account email, and enable the Google Sheets API.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json
CONTROL_SPREADSHEET_ID=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
