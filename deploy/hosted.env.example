# Copy outside the release tree and fill on the server. Never commit real values.
BREKTRA_HOSTED=1
BREKTRA_PUBLIC_ORIGIN=https://brektra.example.com
BREKTRA_BIND_HOST=127.0.0.1
PORT=4310
STORAGE_MODE=sheets
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/brektra-service-account.json
CONTROL_SPREADSHEET_ID=your-dedicated-control-spreadsheet-id
# Generate 32 random bytes as base64. Keep unchanged across restarts and back up privately.
BREKTRA_SECRET_KEY=
# Used only when the control spreadsheet has no members; remove the password after bootstrap.
BREKTRA_OWNER_EMAIL=owner@example.com
BREKTRA_OWNER_NAME=Workspace owner
BREKTRA_OWNER_PASSWORD=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
